# Copie este arquivo para infra/env/.env e ajuste os valores.
# O .env nunca vai para o git. Referência completa: docs/24.

# --- Django ---
# Gere uma chave com: make secret-key
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000

# --- Banco (PostgreSQL no Docker) ---
POSTGRES_DB=jornal
POSTGRES_USER=jornal
POSTGRES_PASSWORD=jornal-dev
# Porta 5433 no Windows para não conflitar com um PostgreSQL local na 5432.
# Dentro do Docker Compose, o endereço é trocado automaticamente para db:5432.
DATABASE_URL=postgres://jornal:jornal-dev@localhost:5433/jornal

# --- Mídia ---
MEDIA_URL=/media/
# MEDIA_ROOT=/data/media   # em produção

# --- Login Microsoft (guia em docs/32). Sem estes valores, só login por senha. ---
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# AUTH_ALLOWED_DOMAINS=professor.educacao.sp.gov.br,educacao.sp.gov.br
# Produção atrás da Cloudflare: IP real para o limite de tentativas de login.
# TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP

# Túnel da Cloudflare e backup só existem em produção: veja infra/env/.env.producao.example.

# --- Clima na página inicial (docs/29). Sem estes valores, usa Osasco, SP. ---
# WEATHER_LAT=-23.5329
# WEATHER_LON=-46.7918
# Endereço da API do Open-Meteo; troque só se auto-hospedar o servidor.
# WEATHER_API_BASE=https://api.open-meteo.com
