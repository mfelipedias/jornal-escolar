# Configuração do SERVIDOR de produção do Jornal Escolar.
#
# No servidor: copie este arquivo para infra/env/.env e troque os valores marcados.
#   cp infra/env/.env.producao.example infra/env/.env
#   nano infra/env/.env
# O .env nunca vai para o git. Guarde uma cópia dele num gerenciador de senhas (docs/31).
# Passo a passo completo em docs/34. Referência das variáveis em docs/24.

# --- Perfis do Docker Compose ---
# "tunel" liga o cloudflared. Deixe vazio para rodar só na rede local (sem internet).
COMPOSE_PROFILES=tunel

# --- Endereço do site ---
# SITE_URL monta os links do sitemap, do WhatsApp e dos buscadores: precisa ser o domínio
# real, com https e sem barra no fim. Confira com: make prod-check
SITE_URL=https://jornal.projetosrosa.com.br
ALLOWED_HOSTS=jornal.projetosrosa.com.br
CSRF_TRUSTED_ORIGINS=https://jornal.projetosrosa.com.br

# --- Django ---
# TROQUE. Gere uma chave no servidor com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Número de processos do site. 3 serve bem para uma escola; com 1 GB de RAM use 2.
GUNICORN_WORKERS=3
# Atrás da Cloudflare o IP real de quem visita vem neste cabeçalho (limite de tentativas de login).
TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP
# Deixe como está. False só para testar sem HTTPS (ex.: pelo navegador do próprio servidor).
SECURE_SSL_REDIRECT=True
# Tempo (segundos) que o navegador lembra de usar só HTTPS. Padrão: 30 dias.
SECURE_HSTS_SECONDS=2592000

# --- Banco (PostgreSQL) ---
# TROQUE a senha. Use só letras e números (ela entra num endereço do tipo postgres://...).
# Gere uma com: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_DB=jornal
POSTGRES_USER=jornal
POSTGRES_PASSWORD=

# --- Cloudflare Tunnel (docs/34, passo 4) ---
# Token mostrado pela Cloudflare ao criar o túnel (começa com "eyJ...").
CLOUDFLARE_TUNNEL_TOKEN=

# --- Porta local do Caddy ---
# Só no próprio servidor (127.0.0.1). A internet chega pelo túnel, não por esta porta.
CADDY_BIND=127.0.0.1
CADDY_PORT=8080

# --- Backup (docs/31) ---
# r2: Cloudflare R2 (padrão). local: pasta do servidor em BACKUP_PASTA_LOCAL.
BACKUP_DESTINO=r2
# Frase longa que criptografa os backups. SEM ELA O BACKUP NÃO SERVE PARA NADA.
# Guarde fora do servidor e nunca troque depois do primeiro backup.
# Pode ter espaços (ex.: cinco palavras aleatórias), mas não use o símbolo $ nem aspas.
BACKUP_PASSPHRASE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jornal-backup
# Pasta usada quando BACKUP_DESTINO=local (caminho no servidor, ex.: /mnt/hd-externo/jornal).
BACKUP_PASTA_LOCAL=../backups

# --- Login Microsoft (docs/32). Sem estes valores, só login por senha. ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
AUTH_ALLOWED_DOMAINS=professor.educacao.sp.gov.br,educacao.sp.gov.br

# --- E-mail pelo Gmail (docs/35): códigos de cadastro e de nova senha. ---
# Sem estes valores, o cadastro próprio e o "Esqueci minha senha" ficam escondidos.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SIGNUP_ALLOWED_DOMAINS=prof.educacao.sp.gov.br,professor.educacao.sp.gov.br

# --- Clima na página inicial (docs/29). Sem estes valores, usa Osasco, SP. ---
# WEATHER_LAT=-23.5329
# WEATHER_LON=-46.7918

# --- Tarefas agendadas (docs/24). Horário do "Worker vivo" no log, em UTC; o padrão é de hora em hora. ---
# WORKER_HEARTBEAT_CRON=0 * * * *
