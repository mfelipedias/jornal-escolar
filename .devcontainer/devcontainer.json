{
  "name": "jornal-escolar (Python 3.13 + uv)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  "features": {
    // Reaproveita o daemon Docker do ambiente externo em vez de subir outro.
    // E o que faz `docker compose up` funcionar aqui de dentro.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // O projeto usa uv (compose roda a imagem ghcr.io/astral-sh/uv:python3.13).
  "postCreateCommand": "pip install --no-cache-dir uv && cd backend && uv sync",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ],
      "settings": { "editor.formatOnSave": true }
    }
  },

  // 8000 = web, 5433 = postgres (portas do compose.yaml do repo)
  "forwardPorts": [8000, 5433],

  "remoteUser": "vscode"
}
